[
  {
    "file": "shot-01-ip-br-addr-target.png",
    "title": "target (Ubuntu Server)",
    "badge": "ip -br addr",
    "width": 940,
    "lines": [
      { "t": "cmd", "p": "armoghan@target:~$ ", "c": "ip -br addr" },
      { "t": "out", "c": "lo     UNKNOWN  127.0.0.1/8 ::1/128" },
      { "t": "out", "c": "enp0s3 UP       10.0.2.15/24" },
      { "t": "out", "c": "enp0s8 UP       192.168.56.102/24" },
      { "t": "blank" },
      {
        "t": "note",
        "c": "# enp0s3 -> NAT, internet access, the usual 10.0.2.15"
      },
      {
        "t": "note",
        "c": "# enp0s8 -> the private lab network, this is your TARGET"
      }
    ]
  },
  {
    "file": "shot-02-ss-tuln.png",
    "title": "target (Ubuntu Server)",
    "badge": "ss -tuln",
    "width": 1040,
    "fontSize": 14,
    "lines": [
      { "t": "cmd", "p": "armoghan@target:~$ ", "c": "ss -tuln" },
      {
        "t": "out",
        "c": "State  Recv-Q Send-Q Local Address:Port   Peer Address:Port  Process"
      },
      {
        "t": "out",
        "c": "LISTEN 0      128          127.0.0.11:39595      0.0.0.0:*"
      },
      {
        "t": "out",
        "c": "LISTEN 0      128               0.0.0.0:22         0.0.0.0:*"
      },
      {
        "t": "out",
        "c": "LISTEN 0      128               0.0.0.0:80         0.0.0.0:*"
      },
      {
        "t": "out",
        "c": "LISTEN 0      128            [::]:22            [::]:*"
      },
      {
        "t": "out",
        "c": "LISTEN 0      128            [::]:80            [::]:*"
      },
      { "t": "blank" },
      { "t": "note", "c": "# :22 is sshd, :80 is apache2" },
      {
        "t": "note",
        "c": "# 0.0.0.0 means it listens on every interface, not just the lab one"
      }
    ]
  },
  {
    "file": "shot-03-export-target.png",
    "title": "kali: security workstation",
    "badge": "bash",
    "width": 900,
    "lines": [
      {
        "t": "cmd",
        "p": "kali㉿kali:~$ ",
        "c": "export TARGET=192.168.56.102"
      },
      { "t": "cmd", "p": "kali㉿kali:~$ ", "c": "echo $TARGET" },
      { "t": "out", "c": "192.168.56.102" },
      { "t": "blank" },
      {
        "t": "note",
        "c": "# one address, stored once. every command below uses $TARGET"
      },
      {
        "t": "note",
        "c": "# gone when the terminal closes. re-export it in a new one."
      }
    ]
  },
  {
