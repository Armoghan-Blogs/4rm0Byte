      },
      { "t": "blank" },
      { "t": "cmd", "p": "armoghan@target:~$ ", "c": "hostname" },
      { "t": "out", "c": "target" },
      { "t": "cmd", "p": "armoghan@target:~$ ", "c": "exit" },
      { "t": "out", "c": "logout" },
      { "t": "cmd", "p": "kali㉿kali:~$ ", "c": "" }
    ]
  },
  {
    "file": "shot-08-nmap-closed.png",
    "title": "kali → target, port 80 stopped",
    "badge": "closed",
    "width": 1120,
    "fontSize": 14,
    "lines": [
      { "t": "note", "c": "# on the target first" },
      {
        "t": "cmd",
        "p": "armoghan@target:~$ ",
        "c": "sudo systemctl stop apache2"
      },
      { "t": "blank" },
      { "t": "note", "c": "# now from kali" },
      { "t": "cmd", "p": "kali㉿kali:~$ ", "c": "nmap -p 22,80 $TARGET" },
      { "t": "blank" },
      { "t": "out", "c": "Starting Nmap 7.99 ( https://nmap.org )" },
      { "t": "out", "c": "Nmap scan report for 192.168.56.102" },
      { "t": "out", "c": "Host is up (0.00044 latency)." },
      { "t": "blank" },
      { "t": "out", "c": "PORT   STATE  SERVICE" },
      { "t": "out", "c": "22/tcp open   ssh" },
      { "t": "out", "c": "80/tcp closed http" },
      { "t": "blank" },
      {
        "t": "note",
        "c": "# closed, not filtered: the host answered with a TCP reset."
      },
      {
        "t": "note",
        "c": "# the machine is there, nothing is listening on 80."
      }
    ]
  },
  {
    "file": "shot-09-ufw-filtered.png",
    "title": "kali → target, ufw enabled",
    "badge": "filtered",
    "width": 1120,
    "fontSize": 14,
    "lines": [
      { "t": "note", "c": "# on the target" },
      {
        "t": "cmd",
        "p": "armoghan@target:~$ ",
        "c": "sudo systemctl start apache2"
      },
      { "t": "cmd", "p": "armoghan@target:~$ ", "c": "sudo ufw allow 22/tcp" },
      { "t": "out", "c": "Rule added" },
      { "t": "out", "c": "Rule added (v6)" },
      { "t": "cmd", "p": "armoghan@target:~$ ", "c": "sudo ufw enable" },
      {
        "t": "out",
        "c": "Command may disrupt existing ssh connections. Proceed with operation (y|n)? y"
      },
      { "t": "out", "c": "Firewall is active and enabled on system startup" },
      { "t": "blank" },
      { "t": "note", "c": "# from kali" },
      { "t": "cmd", "p": "kali㉿kali:~$ ", "c": "nmap -p 22,80 $TARGET" },
      { "t": "blank" },
      { "t": "out", "c": "PORT   STATE  SERVICE" },
      { "t": "out", "c": "22/tcp open     ssh" },
      { "t": "out", "c": "80/tcp filtered http" },
      { "t": "blank" },
      {
        "t": "note",
        "c": "# apache IS running. ufw drops the packets silently instead of"
      },
      {
        "t": "note",
        "c": "# resetting them, so the scanner gets no answer at all."
      },
      { "t": "note", "c": "# undo it when you are done:  sudo ufw disable" }
    ]
  },
  {
    "file": "shot-10-tcpdump.png",
    "title": "kali, interface eth1",
    "badge": "tcpdump",
    "width": 1320,
    "fontSize": 13,
    "lines": [
      {
        "t": "cmd",
        "p": "kali㉿kali:~$ ",
        "c": "sudo tcpdump -i eth1 -n 'tcp port 80'"
      },
      { "t": "blank" },
      { "t": "note", "c": "# in a second terminal" },
      {
        "t": "cmd",
        "p": "kali㉿kali:~$ ",
        "c": "curl -s -o /dev/null http://$TARGET"
      },
      { "t": "blank" },
      {
        "t": "out",
        "c": "02:14:31.882115 IP 192.168.56.101.52344 > 192.168.56.102.80: Flags [S],"
      },
      {
        "t": "out",
        "c": "        seq 248731926, win 64240, options [mss 1460,sackOK,TS val"
      },
      {
        "t": "out",
        "c": "        1185432,e], seq 0, win 64240, options [mss 1460,sackOK,TS val"
      },
      { "t": "out", "c": "        1185432,e], length 0" },
      {
        "t": "out",
        "c": "02:14:31.884022 IP 192.168.56.102.80 > 192.168.56.101.52344: Flags [S.],"
      },
      {
        "t": "out",
        "c": "        seq 2918824473, ack 248731927, win 65160, options [mss 1460,"
      },
      { "t": "out", "c": "        sackOK,TS val 4190874,e], length 0" },
      {
        "t": "out",
        "c": "02:14:31.884108 IP 192.168.56.101.52344 > 192.168.56.102.80: Flags [.],"
      },
      { "t": "out", "c": "        ack 1, win 501, length 0" },
      { "t": "blank" },
      {
        "t": "note",
        "c": "# [S] is SYN, [S.] is SYN-ACK, [.] is ACK. that is the handshake,"
      },
      {
        "t": "note",
        "c": "# on a network you built, before any payload is sent."
      },
      { "t": "out", "c": "^C" },
      { "t": "out", "c": "12 packets captured" },
      { "t": "out", "c": "12 packets received by filter" },
      { "t": "out", "c": "0 packets dropped by kernel" }
    ]
  }
]
