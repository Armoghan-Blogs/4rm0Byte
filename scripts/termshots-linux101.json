  {
    "file": "shot-07-ssh.png",
    "title": "kali → target",
    "badge": "ssh",
    "width": 1120,
    "fontSize": 14,
    "lines": [
      { "t": "cmd", "p": "kali㉿kali:~$ ", "c": "ssh armoghan@$TARGET" },
      {
        "t": "out",
        "c": "The authenticity of host '192.168.56.102' can't be established."
      },
      {
        "t": "out",
        "c": "ED25519 key fingerprint is SHA256:8pQ2xV1mZcR4kL7nWq0dYb3sT9uJ6hF5eA2gXc1Nw."
      },
      {
        "t": "out",
        "c": "Are you sure you want to continue connecting (yes/no/[fingerprint])? yes"
      },
      {
