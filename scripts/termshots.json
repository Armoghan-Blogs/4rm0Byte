  {
    "file": "shot-03-files.png",
    "title": "alice@web01: ~/notes",
    "badge": "bash",
    "width": 1000,
    "lines": [
      { "t": "cmd", "p": "alice@web01:~/notes$ ", "c": "mkdir notes && touch todo.txt" },
      { "t": "cmd", "p": "alice@web01:~/notes$ ", "c": "cp todo.txt backup.txt && mv backup.txt old.txt" },
      { "t": "cmd", "p": "alice@web01:~/notes$ ", "c": "ls" },
      { "t": "out", "c": "old.txt  todo.txt" },
      { "t": "blank" },
      { "t": "cmd", "p": "alice@web01:~/notes$ ", "c": "wc -l todo.txt" },
      { "t": "out", "c": "3 todo.txt" },
      { "t": "blank" },
      { "t": "cmd", "p": "alice@web01:~/notes$ ", "c": "head -n 2 todo.txt" },
      { "t": "out", "c": "rotate logs weekly" },
      { "t": "out", "c": "review failed logins" }
    ]
  },
  {
    "file": "shot-04-grep.png",
    "title": "alice@web01: ~/terminal-practice",
    "badge": "bash",
    "width": 1100,
    "fontSize": 14,
    "lines": [
      { "t": "cmd", "p": "alice@web01:~/terminal-practice$ ", "c": "grep \"Failed password\" auth.log" },
      { "t": "out", "c": "Sep 30 10:01:12 host sshd[811]: Failed password for root from 203.0.113.5 port 51234 ssh2" },
      { "t": "out", "c": "Sep 30 10:01:15 host sshd[811]: Failed password for invalid user admin from 203.0.113.5 port 51236 ssh2" },
      { "t": "out", "c": "Sep 30 10:03:02 host sshd[831]: Failed password for root from 192.0.2.44 port 60110 ssh2" },
      { "t": "out", "c": "Sep 30 10:03:05 host sshd[831]: Failed password for root from 203.0.113.5 port 51240 ssh2" },
      { "t": "blank" },
      { "t": "cmd", "p": "alice@web01:~/terminal-practice$ ", "c": "grep -c \"Failed password\" auth.log" },
      { "t": "out", "c": "4" },
      { "t": "blank" },
      { "t": "note", "c": "# -i ignores case, -n prints line numbers, -c just counts" }
    ]
  },
  {
    "file": "shot-05-pipeline.png",
    "title": "alice@web01: ~/terminal-practice",
    "badge": "bash",
    "width": 1180,
    "fontSize": 14,
    "lines": [
      { "t": "cmd", "p": "$ ", "c": "grep \"Failed password\" auth.log | awk '{print $(NF-3)}' | sort | uniq -c | sort -rn" },
      { "t": "blank" },
      { "t": "out", "c": "      3 203.0.113.5" },
      { "t": "out", "c": "      1 192.0.2.44" },
      { "t": "blank" },
      { "t": "note", "c": "# grep  -> keep the lines that mention a failure" },
      { "t": "note", "c": "# awk   -> print the 3rd field from the end (the source IP)" },
      { "t": "note", "c": "# sort  -> put identical addresses next to each other" },
      { "t": "note", "c": "# uniq  -> collapse duplicates and prefix the count" },
      { "t": "note", "c": "# sort -rn -> biggest offender first" }
    ]
  },
  {
    "file": "shot-06-pipeline-stages.png",
    "title": "alice@web01: ~/terminal-practice",
    "badge": "one stage at a time",
    "width": 1180,
    "fontSize": 14,
    "lines": [
      { "t": "cmd", "p": "$ ", "c": "grep \"Failed password\" auth.log | wc -l" },
      { "t": "out", "c": "4" },
      { "t": "blank" },
      { "t": "cmd", "p": "$ ", "c": "grep \"Failed password\" auth.log | awk '{print $(NF-3)}'" },
      { "t": "out", "c": "203.0.113.5" },
      { "t": "out", "c": "203.0.113.5" },
      { "t": "out", "c": "192.0.2.44" },
      { "t": "out", "c": "203.0.113.5" },
      { "t": "blank" },
      { "t": "note", "c": "# each stage is readable on its own — that is how you find the broken one" }
    ]
  },
  {
    "file": "shot-07-permissions.png",
    "title": "alice@web01: ~/.ssh",
    "badge": "chmod",
    "width": 1080,
    "fontSize": 14,
    "lines": [
      { "t": "cmd", "p": "alice@web01:~/.ssh$ ", "c": "ls -l" },
      { "t": "out", "c": "-rw-------  1 alice alice  1675 Sep 28 18:04 id_ed25519" },
      { "t": "out", "c": "-rw-r--r--  1 alice alice   425 Sep 28 18:04 id_ed25519.pub" },
      { "t": "out", "c": "-rwxr-x---  1 alice alice  1024 Sep 30 10:00 deploy.sh" },
      { "t": "blank" },
      { "t": "cmd", "p": "alice@web01:~/.ssh$ ", "c": "ls -l deploy.sh" },
      { "t": "out", "c": "-rwxr-x---  1 alice alice 1024 Sep 30 10:00 deploy.sh" },
      { "t": "blank" },
      { "t": "note", "c": "# owner  rwx  = 7      group  r-x  = 5      world  ---  = 0   ->  750" },
      { "t": "note", "c": "# id_ed25519 is 600: readable only by alice, so ssh will accept it" }
    ]
  },
  {
