  {
    "file": "shot-09-curl-pipe-bash.png",
    "title": "the one-liner you should be careful with",
    "badge": "curl | bash",
    "width": 1120,
    "fontSize": 14,
    "lines": [
      { "t": "note", "c": "# the pattern you will see in READMEs everywhere:" },
      { "t": "blank" },
      { "t": "cmd", "p": "$ ", "c": "curl -fsSL https://example.com/install.sh | bash" },
      { "t": "out", "c": "  ... downloads a script and runs it immediately" },
      { "t": "blank" },
      { "t": "note", "c": "# the version you can actually check:" },
      { "t": "blank" },
      { "t": "cmd", "p": "$ ", "c": "curl -fsSLO https://example.com/install.sh" },
      { "t": "out", "c": "  # download only" },
      { "t": "cmd", "p": "$ ", "c": "less install.sh" },
      { "t": "out", "c": "  # read it" },
      { "t": "cmd", "p": "$ ", "c": "bash install.sh" },
      { "t": "out", "c": "  # run it once you are satisfied" }
    ]
  },
  {
